# Database runtime consolidation mode: "legacy" (default when unset) or "unified".
# - legacy: Programs -> POSTGRES_URL, Courses -> COURSES_POSTGRES_URL, Transfers -> TRANSFERS_POSTGRES_URL (3 pools)
# - unified: all three feature domains share one global pg.Pool (max: 1) connected to POSTGRES_URL
SNHU_TOOLS_DATABASE_MODE="legacy"

# Programs / Degree Map database (in unified mode, shared by Programs, Courses, and Transfers)
POSTGRES_URL="postgresql://user:password@host:port/dbname?sslmode=require"
# Legacy Neon direct URL retained for rollback documentation only; runtime uses POSTGRES_URL.
# POSTGRES_URL_NON_POOLING="postgresql://user:password@host:port/dbname?sslmode=require"
# Verified TLS for Aiven and other managed PostgreSQL providers (inline PEM or filesystem path).
# POSTGRES_CA_CERT=".aiven/programs-ca.pem"

# Courses database — temporary migration bridge (active in legacy mode; retained for rollback)
COURSES_POSTGRES_URL="postgresql://user:password@host:port/dbname?sslmode=require"
# COURSES_POSTGRES_CA_CERT=".aiven/courses-ca.pem"

# Transfers database — temporary migration bridge (active in legacy mode; retained for rollback)
TRANSFERS_POSTGRES_URL="postgresql://user:password@host:port/dbname?sslmode=require"
# TRANSFERS_POSTGRES_CA_CERT=".aiven/transfers-ca.pem"

# ── Revalidation & Site URLs ─────────────────────────────────────────────
REVALIDATE_SECRET="your-secure-revalidation-secret-token"
SITE_URL="https://snhu-degreemap.vercel.app"
NEXT_PUBLIC_SITE_URL="https://snhu-degreemap.vercel.app"

# ── Kuali Source Catalog ──────────────────────────────────────────────────
KUALI_BASE_URL="https://snhu.kuali.co"
KUALI_CATALOG_ID="6349a3f9164d00001c6c80da"
KUALI_CATALOG_YEAR_LABEL="2025-2026"
KUALI_REQUEST_TIMEOUT_MS="10000"
KUALI_USER_AGENT="SNHU-DegreeMap-Sync/1.0 (+https://github.com/andrewtryder/snhu-degreemap)"

# ── Optional Monitoring ───────────────────────────────────────────────────
# HONEYBADGER_API_KEY=""
# NEXT_PUBLIC_HONEYBADGER_API_KEY=""
