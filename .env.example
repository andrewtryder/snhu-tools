# Shared PostgreSQL database for Programs, Courses, and Transfers.
# The Vercel runtime uses the Neon pooled/PgBouncer endpoint.
POSTGRES_URL="postgresql://user:password@host:port/dbname?sslmode=require"
# Optional verified TLS CA certificate for managed PostgreSQL (inline PEM or filesystem path).
# POSTGRES_CA_CERT=".aiven/programs-ca.pem"

# ── Revalidation & Site URLs ─────────────────────────────────────────────
REVALIDATE_SECRET="your-secure-revalidation-secret-token"
SITE_URL="https://snhu-tools.vercel.app"
NEXT_PUBLIC_SITE_URL="https://snhu-tools.vercel.app"

# ── Kuali Source Catalog ──────────────────────────────────────────────────
KUALI_BASE_URL="https://snhu.kuali.co"
KUALI_CATALOG_ID="6349a3f9164d00001c6c80da"
KUALI_CATALOG_YEAR_LABEL="2025-2026"
KUALI_REQUEST_TIMEOUT_MS="10000"
KUALI_USER_AGENT="SNHU-Tools-Sync/1.0 (+https://github.com/andrewtryder/snhu-tools)"

# ── Durable snapshots (Vercel Blob) ───────────────────────────────────────
# Required in Production for last-known-good catalog reads during Neon outages.
# Writers publish after each successful promote; public reads prefer snapshots.
# BLOB_READ_WRITE_TOKEN=""
# SNAPSHOT_STORE="blob"   # or "fs" for local/tests (default when no Blob token)

# ── Optional Monitoring ───────────────────────────────────────────────────
# Error monitoring is disabled unless explicitly enabled.
# Keep these false while the Honeybadger quota issue is being handled.
# API keys may remain configured; notices are not sent when enabled=false.
HONEYBADGER_ENABLED="false"
NEXT_PUBLIC_HONEYBADGER_ENABLED="false"
# HONEYBADGER_API_KEY=""
# NEXT_PUBLIC_HONEYBADGER_API_KEY=""
